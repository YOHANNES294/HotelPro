# HotelPro Environment Configuration
# Copy this file to .env and replace placeholder values

# Database Configuration
DATABASE_URL="postgresql://hotelpro:hotelpro_dev_password@localhost:5432/hotelpro?schema=public"
POSTGRES_DB="hotelpro"
POSTGRES_USER="hotelpro"
POSTGRES_PASSWORD="change_this_to_a_secure_random_password_min_32_chars"
POSTGRES_PORT=5432

# Backend API Configuration
PORT=4000
NODE_ENV="development"
JWT_SECRET="replace_with_high_entropy_jwt_secret_hex_64_chars"
JWT_EXPIRES_IN="15m"
REFRESH_SECRET="replace_with_high_entropy_refresh_secret_hex_64_chars"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://hotelpro.app"

# Web Client Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Payment Gateway Configuration (Production Requirements)
# TELEBIRR_APP_ID=""
# TELEBIRR_APP_KEY=""
# TELEBIRR_SHORT_CODE=""
# TELEBIRR_PUBLIC_KEY=""
# TELEBIRR_PRIVATE_KEY=""
# CBE_BIRR_MERCHANT_ID=""
# CBE_BIRR_API_KEY=""
# CBE_BIRR_WEBHOOK_SECRET=""

{
  "name": "hotelpro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@hotelpro/api",
    "dev:web": "npm run dev --workspace=@hotelpro/web",
    "dev:mobile": "npm run dev --workspace=@hotelpro/mobile",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@hotelpro/shared",
    "build:api": "npm run build --workspace=@hotelpro/api",
    "build:web": "npm run build --workspace=@hotelpro/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=@hotelpro/api",
    "db:generate": "npm run db:generate --workspace=@hotelpro/api",
    "db:seed": "npm run db:seed --workspace=@hotelpro/api",
    "db:studio": "npm run db:studio --workspace=@hotelpro/api"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  }
}
